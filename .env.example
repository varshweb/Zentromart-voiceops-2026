# Gnani.ai API Configuration (Required for live STT and TTS)
# Obtain your unified API key from https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here

# Speech Model Settings
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_MODEL=timbre-v2.5
GNANI_STT_LANG=en-IN

# Optional Hosted LLM Keys (fallback uses offline grounded RAG engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
